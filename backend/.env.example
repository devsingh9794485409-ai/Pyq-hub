PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pyqhub

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=pyqhub

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A (recommended): paste the entire service-account JSON as one line
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Option B: individual fields (used only if FIREBASE_SERVICE_ACCOUNT is not set)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
